# Copy to .env only if absent; fill placeholders privately.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/safesite_local
# Bootstrap only: private values of at least eight characters, no defaults.
SAFESITE_LOCAL_ADMIN_PASSWORD=
SAFESITE_LOCAL_OFFICER_PASSWORD=
SAFESITE_LOCAL_USER_PASSWORD=
SAFESITE_DEMO_ADMIN_PASSWORD=
SAFESITE_DEMO_OFFICER_PASSWORD=
SAFESITE_DEMO_USER_PASSWORD=
